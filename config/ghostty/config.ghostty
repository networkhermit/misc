auto-update = off
background-opacity = 0.8
bold-color = bright
env = PARTY_LIKE_ITS_1995=true
font-family = SF Mono
font-feature = -calt
font-size = 16
keybind = alt+arrow_down=goto_split:down
keybind = alt+arrow_left=goto_split:left
keybind = alt+arrow_right=goto_split:right
keybind = alt+arrow_up=goto_split:up
keybind = alt+shift+-=new_split:down
keybind = alt+shift++=new_split:right
keybind = ctrl+backspace=toggle_fullscreen
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+v=paste_from_clipboard
macos-option-as-alt = true
mouse-hide-while-typing = true
scrollback-limit-lines = 10000
shell-integration-features = no-cursor
term = xterm-256color
theme = modbus-vivendi
window-padding-x = 4
window-padding-y = 2
window-save-state = never
window-theme = system
